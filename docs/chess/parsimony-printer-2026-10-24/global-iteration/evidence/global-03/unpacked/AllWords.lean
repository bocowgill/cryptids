theorem allWords (i : Fin 13360) (L R : ListBlank (Fin 2)) :
    let v := (Parsimony.Data.wordAt 13359 values i.val).val
    ∃ out : List (Fin 2), out.length = 13 ∧ Parsimony.Counter.value out = v ∧
    Parsimony.Common.Runs (model values)
      ⟨data i.val, Tape.mk' (L.cons 0) ((Z (v + 1) (Z 15 R)).cons 1)⟩
      ⟨data 0, Tape.mk' ((ListBlank.append out L).cons 0) (((Z (v + 2) R).cons 1).cons 0)⟩ := by
  exact Parsimony.Extractor.query_extract (model values) data exit 13359 values
    (row_more values) (row_last values) (row_one values) insert convert 13
    (insert_rows values) (convert_rows values) (by decide +kernel) rfl rfl (by omega)
    i.val (by have := i.isLt; omega) (by
      simpa only [values, show (2 : Nat) ^ 13 = 8192 by decide +kernel]
        using words_bound raw i.val) L R


def insertionRight (i : Nat) : Fin 13546 := select (#[13371, 13378, 13385, 13392, 13399, 13406,
    13413, 13420, 13427, 13434, 13441, 13448, 13455]) i

theorem indexed_insert_rows (values : Array (Fin 13360)) :
    Parsimony.IndexedInsertion.Rows (model values) insert 13 insertionRight where
  base := insert_rows values
  secondOne := by
    intro i upper
    have physical :
      ∀ j : Fin 13, 13366 ≤ (insert.second j.val).val := by decide +kernel
    have finite :
      ∀ j : Fin 13, (model #[]).transition (insert.second j.val) 1 = some (1, .left, insert.second
      j.val) := by decide +kernel
    rw [static_eq values #[] (insert.second i) 1 (physical ⟨i, upper⟩)]
    exact finite ⟨i, upper⟩
  putOne := by
    intro i upper
    have physical :
      ∀ j : Fin 13, 13366 ≤ (insert.put j.val).val := by decide +kernel
    have finite :
      ∀ j : Fin 13, (model #[]).transition (insert.put j.val) 1 = some (0, .right, insertionRight
      j.val) := by decide +kernel
    rw [static_eq values #[] (insert.put i) 1 (physical ⟨i, upper⟩)]
    exact finite ⟨i, upper⟩
  rightOne := by
    intro i upper
    have physical :
      ∀ j : Fin 13, 13366 ≤ (insertionRight j.val).val := by decide +kernel
    have finite :
      ∀ j : Fin 13, (model #[]).transition (insertionRight j.val) 1 = some (1, .right,
      insertionRight j.val) := by decide +kernel
    rw [static_eq values #[] (insertionRight i) 1 (physical ⟨i, upper⟩)]
    exact finite ⟨i, upper⟩
  rightZero := by
    intro i upper
    have physical :
      ∀ j : Fin 13, 13366 ≤ (insertionRight j.val).val := by decide +kernel
    have finite :
      ∀ j : Fin 13, (model #[]).transition (insertionRight j.val) 0 = some (1, .right,
      insert.middle j.val) := by decide +kernel
    rw [static_eq values #[] (insertionRight i) 0 (physical ⟨i, upper⟩)]
    exact finite ⟨i, upper⟩

theorem indexed_convert_rows (values : Array (Fin 13360)) :
    Parsimony.IndexedExtractor.Rows (model values) convert 13 where
  base := convert_rows values
  secondOne := by
