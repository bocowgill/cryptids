def model (values : Array (Fin 13360)) : Machine 13546 2 where
  transition state bit :=
    if state.val < 6 then none else
    if state.val < 13366 then
      if bit = 0 then
        if state.val < 13365 then some (1, .right, data (state.val - 6 + 1))
        else some (0, .right, exit)
      else some (0, .right, data (13359 - (Parsimony.Data.wordAt 13359 values
        (state.val - 6)).val))
    else staticRows[(state.val - 13366) * 2 + bit.val]?

theorem row_more (values : Array (Fin 13360)) (i : Nat) (bound : i < 13359) :
    (model values).transition (data i) 0 = some (1, .right, data (i + 1)) := by
  have le : i ≤ 13359 := by omega
  have next : i + 1 ≤ 13359 := by omega
  simp [model, data, Nat.min_eq_left le, Nat.min_eq_left next,
    show ¬6 + i < 6 by omega, show 6 + i < 13366 by omega,
    show 6 + i < 13365 by omega]

theorem row_last (values : Array (Fin 13360)) :
    (model values).transition (data 13359) 0 = some (0, .right, exit) := by
  rfl

theorem row_one (values : Array (Fin 13360)) (i : Nat) (bound : i ≤ 13359) :
    (model values).transition (data i) 1 =
      some (0, .right, data (13359 - (Parsimony.Data.wordAt 13359 values i).val)) := by
  simp [model, data, Nat.min_eq_left bound,
    show ¬6 + i < 6 by omega, show 6 + i < 13366 by omega]

theorem static_eq (first second : Array (Fin 13360)) (state : Fin 13546) (bit : Fin 2)
    (bound : 13366 ≤ state.val) :
    (model first).transition state bit = (model second).transition state bit := by
  simp only [model, show ¬state.val < 6 by omega,
    show ¬state.val < 13366 by omega, ↓reduceIte]

private def select (items : Array Nat) (i : Nat) : Fin 13546 :=
  stateOf (items[i]?.getD 13544)

def insert : Parsimony.Insertion.Controls 13546 where
  a i := select (#[13367, 13374, 13381, 13388, 13395, 13402, 13409, 13416, 13423, 13430, 13437,
    13444, 13451, 13457]) i
  b i := select (#[13544, 13373, 13380, 13387, 13394, 13401, 13408, 13415, 13422, 13429, 13436,
    13443, 13450, 13458]) i
  first i := select (#[13368, 13375, 13382, 13389, 13396, 13403, 13410, 13417, 13424, 13431,
    13438, 13445, 13452]) i
  second i := select (#[13369, 13376, 13383, 13390, 13397, 13404, 13411, 13418, 13425, 13432,
    13439, 13446, 13453]) i
  put i := select (#[13370, 13377, 13384, 13391, 13398, 13405, 13412, 13419, 13426, 13433, 13440,
    13447, 13454]) i
  middle i := select (#[13372, 13379, 13386, 13393, 13400, 13407, 13414, 13421, 13428, 13435,
    13442, 13449, 13456]) i
  back := stateOf 13459
  out := stateOf 13460

def increment (carry : Bool) (i : Nat) : Fin 13546 :=
  if carry then select (#[13468, 13469, 13472, 13475, 13478, 13481, 13484, 13487, 13490, 13493,
    13496, 13499, 13502]) i
  else select (#[13544, 13470, 13473, 13476, 13479, 13482, 13485, 13488, 13491, 13494, 13497,
    13500, 13503]) i

def back (i : Nat) : Fin 13546 := select (#[13544, 13471, 13474, 13477, 13480, 13483, 13486,
    13489, 13492, 13495, 13498, 13501, 13504, 13505]) i

def convert : Parsimony.Extractor.Controls 13546 where
  scan := insert.out
  delete := stateOf 13461
  first := stateOf 13462
  second := stateOf 13463
  returnToUnary := stateOf 13464
  makeMarker := stateOf 13465
  moveLeft := stateOf 13466
  clean := stateOf 13467
  data := data 0
  counter := increment
  back := back

theorem counter_rows (values : Array (Fin 13360)) :
    Parsimony.Counter.Rows (model values) increment back 13 where
  more := by
    intro i bound carry bit valid
    have physical :
      ∀ j : Fin 12, ∀ carry : Bool, ∀ bit : Fin 2, (0 < j.val ∨ carry = true) → 13366 ≤ (increment
      carry j.val).val := by decide +kernel
    have finite :
      ∀ j : Fin 12, ∀ carry : Bool, ∀ bit : Fin 2, (0 < j.val ∨ carry = true) → (model
      #[]).transition (increment carry j.val) bit = some (Parsimony.Counter.digit carry bit,
      .left, increment (Parsimony.Counter.next carry bit) (j.val + 1)) := by decide +kernel
    rw [static_eq values #[] (increment carry i) bit (physical ⟨i, by omega⟩ carry bit valid)]
    exact finite ⟨i, by omega⟩ carry bit valid
  last := by
    intro carry bit clear
    have physical :
      ∀ carry : Bool, ∀ bit : Fin 2, Parsimony.Counter.next carry bit = false → 13366 ≤ (increment
      carry 12).val := by decide +kernel
    have finite :
      ∀ carry : Bool, ∀ bit : Fin 2, Parsimony.Counter.next carry bit = false → (model
      #[]).transition (increment carry 12) bit = some (Parsimony.Counter.digit carry bit, .right,
      back 1) := by decide +kernel
    rw [static_eq values #[] (increment carry 12) bit (physical carry bit clear)]
    exact finite carry bit clear
  back := by
    intro i lower upper bit
    have physical :
      ∀ j : Fin 13, 1 ≤ j.val → ∀ bit : Fin 2, 13366 ≤ (back j.val).val := by decide +kernel
    have finite :
      ∀ j : Fin 13, 1 ≤ j.val → ∀ bit : Fin 2, (model #[]).transition (back j.val) bit = some
      (bit, .right, back (j.val + 1)) := by decide +kernel
    rw [static_eq values #[] (back i) bit (physical ⟨i, upper⟩ lower bit)]
    exact finite ⟨i, upper⟩ lower bit

