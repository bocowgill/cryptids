/-- The complete program contains a literal operation at every frozen source label. -/
def program (q : Label) : Op 4042 := (entries.lookup q.val (.halt, .halt)).1

/-- Universal correspondence on all labels, with no reachability or row-class premise. -/
theorem source_program (q : Label) : source (program q) = SharedModel.machine q := by
  have same := congrArg (fun tree ↦ tree.lookup q.val (.halt : SharedModel.Stmt)) rows_match
  have lookupRows : (entries.lookup q.val (.halt, .halt)).2 = SharedModel.machine q := by
    simpa only [SharedModel.machine, SharedModel.entry] using
      (project_lookup Prod.snd entries q.val (.halt, .halt)).symm.trans
        (same.trans (project_lookup Prod.fst SharedModel.entries q.val (.halt, .halt)))
  exact (correct_lookup entries checked q.val).trans lookupRows

theorem program_source : (fun q ↦ source (program q)) = SharedModel.machine :=
  funext source_program

/-- Pure operation-tree projection for consumers that need the literal finite program. -/
def operations : Balanced.RowTree (Op 4042) := project Prod.fst entries

theorem operations_lookup (q : Label) : operations.lookup q.val .halt = program q := by
  exact project_lookup Prod.fst entries q.val (.halt, .halt)

theorem entries_count : entries.count = 4042 := rfl

theorem entries_wellFormed : entries.WellFormed := by decide +kernel

end ConjectureMachines.Compilation.FieldCompiler.Snapshot
