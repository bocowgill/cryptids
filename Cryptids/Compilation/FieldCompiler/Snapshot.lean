abbrev Label := SharedModel.Label
abbrev Entry := Op 4042 × SharedModel.Stmt

/-- Conjugate a source store update by the exact five-symbol codec. -/
def storeMap (f : Store → Store) (v : Fin 5) : Fin 5 :=
  FieldReturn.symbolCode (f (FieldReturn.codeSymbol v))

def readMap (f : Store → Store → Store) (v symbol : Fin 5) : Fin 5 :=
  FieldReturn.symbolCode (f (FieldReturn.codeSymbol v) (FieldReturn.codeSymbol symbol))

def testMap (f : Store → Bool) (v : Fin 5) : Bool := f (FieldReturn.codeSymbol v)

def targetMap (f : Store → Label) (v : Fin 5) : Label := f (FieldReturn.codeSymbol v)

theorem source_write (field : Fin 4) (f : Store → Store) (next : Label) :
    source (.write field (storeMap f) next) =
      .write (fun a v ↦ (a.1, Function.update a.2 (FieldReturn.stackAt field) (f v)))
        (.goto fun _ _ ↦ next) := by
  simp only [source, storeMap, FieldReturn.symbol_roundtrip]

theorem source_load (field : Fin 4) (f : Store → Store → Store) (next : Label) :
    source (.load field (readMap f) next) =
      .load (fun a v ↦ f v (a.2 (FieldReturn.stackAt field))) (.goto fun _ _ ↦ next) := by
  simp only [source, readMap, FieldReturn.symbol_roundtrip]

theorem source_pureLoad (f : Store → Store) (next : Label) :
    source (.pureLoad (storeMap f) next) =
      .load (fun _ v ↦ f v) (.goto fun _ _ ↦ next) := by
  simp only [source, storeMap, FieldReturn.symbol_roundtrip]

theorem source_branch (f : Store → Bool) (yes no : Label) :
    source (.branch (testMap f) yes no) =
      .branch (fun _ v ↦ f v) (.goto fun _ _ ↦ yes) (.goto fun _ _ ↦ no) := by
  simp only [source, testMap, FieldReturn.symbol_roundtrip]

theorem source_jump (f : Store → Label) :
    source (.jump (targetMap f)) = .goto (fun _ v ↦ f v) := by
  simp only [source, targetMap, FieldReturn.symbol_roundtrip]

/-- Every leaf is checked, without enumerating the simultaneous-stack alphabet. -/
def Correct : Balanced.RowTree Entry → Prop
  | .empty => True
  | .leaf row => source row.1 = row.2
  | .branch _ left right => Correct left ∧ Correct right

/-- Source correctness also holds for out-of-range lookups: both fallbacks halt. -/
theorem correct_lookup (tree : Balanced.RowTree Entry) (checked : Correct tree) (i : Nat) :
    source (tree.lookup i (.halt, .halt)).1 = (tree.lookup i (.halt, .halt)).2 := by
  induction tree generalizing i with
  | empty => rfl
  | leaf row =>
    by_cases h : i = 0
    · simpa only [Correct, Balanced.RowTree.lookup, h, ↓reduceIte] using checked
    · simp only [Balanced.RowTree.lookup, h, ↓reduceIte, source]
  | branch count left right ihl ihr =>
    obtain ⟨cl, cr⟩ := checked
    by_cases h : i < count
    · simpa only [Balanced.RowTree.lookup, h, ↓reduceIte] using ihl cl i
    · simpa only [Balanced.RowTree.lookup, h, ↓reduceIte] using ihr cr (i - count)

/-- Structural projection retains every cached count and every leaf position. -/
def project {α β : Type} (f : α → β) : Balanced.RowTree α → Balanced.RowTree β
  | .empty => .empty
  | .leaf row => .leaf (f row)
  | .branch count left right => .branch count (project f left) (project f right)

theorem project_lookup {α β : Type} (f : α → β) (tree : Balanced.RowTree α)
    (i : Nat) (fallback : α) :
    (project f tree).lookup i (f fallback) = f (tree.lookup i fallback) := by
  induction tree generalizing i with
  | empty => rfl
  | leaf row => by_cases h : i = 0 <;> simp only [project, Balanced.RowTree.lookup, h, ↓reduceIte]
  | branch count left right ihl ihr =>
    by_cases h : i < count <;>
      simp only [project, Balanced.RowTree.lookup, h, ↓reduceIte, ihl, ihr]

